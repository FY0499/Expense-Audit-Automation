    {
      "parameters": {
        "jsCode": "// بيانات المصروف الجديد من الفورم\nconst newExpense = $('On form submission').first().json;\n\n// البيانات القديمة القادمة من Google Sheets\n// ونستبعد الـ item الفاضي الناتج عن Always Output Data\nconst history = $input.all()\n  .map(item => item.json)\n  .filter(row => row && row['اسم المتجر/المورد'] !== undefined);\n\n\n// ===== توحيد البيانات =====\n\nconst normalizeStore = (s) => {\n  return String(s ?? '').trim().toLowerCase();\n};\n\nconst normalizeAmount = (a) => {\n  const n = parseFloat(\n    String(a ?? '')\n      .replace(/,/g, '')\n      .trim()\n  );\n\n  return isNaN(n)\n    ? null\n    : Math.round(n * 100) / 100;\n};\n\nconst normalizeDate = (d) => {\n  const s = String(d ?? '').trim();\n\n  return s.length >= 10\n    ? s.slice(0, 10)\n    : s;\n};\n\n\n// ===== المصروف الجديد =====\n\nconst newStore = normalizeStore(\n  newExpense['اسم المتجر/المورد']\n);\n\nconst newAmount = normalizeAmount(\n  newExpense['المبلغ']\n);\n\nconst newDate = normalizeDate(\n  newExpense['التاريخ']\n);\n\n\n// ===== فحص التكرار =====\n\nconst duplicates = history.filter(row => {\n\n  const sameStore =\n    normalizeStore(row['اسم المتجر/المورد']) === newStore;\n\n  const sameAmount =\n    normalizeAmount(row['المبلغ']) === newAmount;\n\n  const sameDate =\n    normalizeDate(row['التاريخ']) === newDate;\n\n  return sameStore && sameAmount && sameDate;\n});\n\n\n// ===== حساب متوسط المصاريف =====\n\nconst amounts = history\n  .map(row => normalizeAmount(row['المبلغ']))\n  .filter(amount => amount !== null);\n\nlet avg = 0;\n\nif (amounts.length > 0) {\n  avg =\n    amounts.reduce((sum, amount) => sum + amount, 0)\n    / amounts.length;\n}\n\n\n// ===== فحص المبلغ غير المعتاد =====\n// أكبر من 3 أضعاف المتوسط\n\nconst isUnusual =\n  avg > 0 &&\n  newAmount !== null &&\n  newAmount > avg * 3;\n\n\n// ===== النتيجة =====\n\nreturn [\n  {\n    json: {\n      store: newExpense['اسم المتجر/المورد'],\n      amount: newAmount,\n      category: newExpense['التصنيف'],\n      date: newExpense['التاريخ'],\n\n      isDuplicate: duplicates.length > 0,\n      isUnusualAmount: isUnusual,\n\n      duplicateCount: duplicates.length,\n      averageAmount: avg.toFixed(2)\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
