        }
      }
    },
    {
      "parameters": {
        "jsCode": "// نتيجة الـ AI Agent\nconst raw = $('AI Agent').first().json.output \n  ?? $('AI Agent').first().json.text \n  ?? '';\n\n// إزالة ```json و ``` إذا Gemini رجع النتيجة داخل code block\nconst cleaned = String(raw)\n  .replace(/```json/gi, '')\n  .replace(/```/g, '')\n  .trim();\n\n// تحويل جواب الـ AI إلى JSON\nconst parsed = JSON.parse(cleaned);\n\n// نتيجة فحص التكرار والمبلغ غير المعتاد\nconst expenseCheck = $('Code in JavaScript').first().json;\n\n// دمج نتيجة الفحص مع نتيجة Gemini\nreturn [\n  {\n    json: {\n      ...expenseCheck,\n      ...parsed\n    }\n  }\n];"
      },
