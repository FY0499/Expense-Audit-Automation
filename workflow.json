    {
      "parameters": {
        "promptType": "define",
        "text": "=أنت مدقق حسابات. راجع بيانات هذا المصروف وحدد إذا كان التصنيف صحيح منطقياً، واكتب ملاحظة تدقيق مختصرة. أعد النتيجة كـ JSON فقط: {\"category_seems_correct\": true/false, \"suggested_category\": \"...\", \"audit_note\": \"...\"}\n\nالمتجر: {{ $json.store }}\nالمبلغ: {{ $json.amount }}\nالتصنيف المُدخل: {{ $json.category }}\nمكرر؟: {{ $json.isDuplicate }}\nمبلغ غير معتاد؟: {{ $json.isUnusualAmount }} (المتوسط: {{ $json.averageAmount }})",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
